+    return false;
+  }
+  // In a pass the buffer is in read usage (draws switch to it before the pass starts). Any other
+  // state means a transition is still pending, which only the ordinary path orders correctly.
+  if (last_usage_ != Usage::kRead || last_written_range_.second) {
+    return false;
+  }
+  const size_t begin_position = command_processor_.render_pass_begin_position();
+  if (begin_position == SIZE_MAX) {
+    return false;
+  }
+  for (const auto& range : upload_page_ranges) {
+    if (command_processor_.SharedMemoryReadInCurrentPass(range.first << page_size_log2(),
+                                                         range.second << page_size_log2())) {
+      return false;
+    }
