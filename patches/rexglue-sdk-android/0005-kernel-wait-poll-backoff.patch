+REXCVAR_DEFINE_UINT32(kernel_wait_poll_backoff_us, 0, "Kernel",
+                      "A guest thread that keeps calling kernel waits which time out in a tight "
+                      "loop (polling) sleeps this many microseconds per call instead of only "
+                      "yielding its timeslice, once it has timed out several times in a row. "
+                      "sched_yield does not stop such a loop from holding a core at 100%: on a "
+                      "handheld that is heat and a core taken from the threads doing real work. "
+                      "0 = the original behaviour (yield only).");
+
 namespace rex::system {
 
+namespace {
+
+// Called where a wait has just timed out. The original behaviour is a plain yield. With the cvar
+// set, a thread whose waits keep timing out back to back (gaps under 2 ms, so it is not a thread
+// doing real timed waits) sleeps briefly: the guest still gets its TIMEOUT result, just not as
+// fast as the CPU can produce it.
+void OnWaitTimedOut() {
+  const uint32_t backoff_us = REXCVAR_GET(kernel_wait_poll_backoff_us);
+  if (!backoff_us) {
+    rex::thread::MaybeYield();
+    return;
+  }
+  thread_local uint32_t consecutive = 0;
+  thread_local std::chrono::steady_clock::time_point last{};
+  const auto now = std::chrono::steady_clock::now();
+  if (now - last > std::chrono::milliseconds(2)) {
+    consecutive = 0;
+  }
+  if (++consecutive >= 8) {
+    std::this_thread::sleep_for(std::chrono::microseconds(backoff_us));
+    last = std::chrono::steady_clock::now();
+  } else {
+    rex::thread::MaybeYield();
+    last = now;
+  }
+}
+
+}  // namespace
