+// ---- gpu_pass_timing -------------------------------------------------------------------------
+
+void VulkanCommandProcessor::PassTimestamp(uint32_t tag) {
+  if (pass_ts_pool_ == VK_NULL_HANDLE || !submission_open_) {
+    return;
+  }
+  const uint32_t slot = uint32_t(frame_current_ % kMaxFramesInFlight);
+  if (pass_ts_slot_frame_[slot] != frame_current_ ||
+      pass_ts_count_[slot] >= kPassTimestampsPerFrame) {
+    return;
+  }
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, pass_ts_pool_,
+      slot * kPassTimestampsPerFrame + pass_ts_count_[slot]);
+  pass_ts_tags_[slot].push_back(tag);
+  ++pass_ts_count_[slot];
+}
+
+namespace {
+std::vector<std::string>& PassTimingSites() {
+  static std::vector<std::string> sites;  // command processor thread only
+  return sites;
+}
+}  // namespace
+
+uint32_t VulkanCommandProcessor::PassTimingSiteId(const char* file, uint32_t line) {
+  if (pass_ts_pool_ == VK_NULL_HANDLE) {
+    return 0;
+  }
+  const char* slash = std::strrchr(file, '/');
+  std::string name = fmt::format("{}:{}", slash ? slash + 1 : file, line);
+  auto& sites = PassTimingSites();
+  for (uint32_t i = 0; i < sites.size(); ++i) {
+    if (sites[i] == name) {
+      return i;
+    }
+  }
+  sites.push_back(std::move(name));
+  return uint32_t(sites.size() - 1);
+}
+
+void VulkanCommandProcessor::PassTimingHarvest() {
+  struct Agg {
+    double ns = 0.0;
+    uint64_t n = 0;
+  };
+  static std::map<uint32_t, Agg> by_site;
+  static std::map<uint32_t, Agg> by_block;
+  static Agg gaps, tail;
+  static uint64_t frames = 0;
+  static double frame_ns = 0.0;
+  const ui::vulkan::VulkanDevice* const device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = device->functions();
+  for (uint32_t slot = 0; slot < kMaxFramesInFlight; ++slot) {
+    const uint64_t slot_frame = pass_ts_slot_frame_[slot];
+    const uint32_t n = pass_ts_count_[slot];
+    if (!slot_frame || slot_frame > frame_completed_ || n < 2) {
+      continue;
+    }
+    uint64_t stamps[kPassTimestampsPerFrame] = {};
+    if (dfn.vkGetQueryPoolResults(device->device(), pass_ts_pool_, slot * kPassTimestampsPerFrame, n,
+                                  n * sizeof(uint64_t), stamps, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      continue;
+    }
+    pass_ts_slot_frame_[slot] = 0;
+    const std::vector<uint32_t>& tags = pass_ts_tags_[slot];
+    if (tags.size() != n || tags.back() != 0xFFFFFFFCu) {
+      continue;  // Frame did not close cleanly (or overflowed).
+    }
+    for (uint32_t i = 1; i < n; ++i) {
+      if (stamps[i] < stamps[i - 1]) {
+        continue;
+      }
+      const double ns = double(stamps[i] - stamps[i - 1]) * timestamp_period_ns_;
+      const uint32_t tag = tags[i];
+      if (tag == 0xFFFFFFFDu) {
+        gaps.ns += ns;
+        ++gaps.n;
+      } else if (tag == 0xFFFFFFFCu) {
+        tail.ns += ns;
+        ++tail.n;
+      } else if (tag & 0x80000000u) {
+        Agg& a = by_block[tag & 0x7FFFFFFFu];
+        a.ns += ns;
+        ++a.n;
+      } else {
+        Agg& a = by_site[tag];
+        a.ns += ns;
+        ++a.n;
+      }
+    }
+    if (stamps[n - 1] > stamps[0]) {
+      frame_ns += double(stamps[n - 1] - stamps[0]) * timestamp_period_ns_;
+    }
+    if (++frames >= 240) {
+      const double f = double(frames);
+      double pass_ns = 0.0;
+      uint64_t pass_n = 0;
+      std::vector<std::pair<double, uint32_t>> sorted;
+      for (const auto& [id, a] : by_site) {
+        pass_ns += a.ns;
+        pass_n += a.n;
+        sorted.push_back({a.ns, id});
+      }
+      std::sort(sorted.rbegin(), sorted.rend());
+      std::string report = fmt::format(
+          "gpu pass timing ({} frames): frame {:.2f} ms | in-pass {:.2f} ms ({:.1f} passes) | "
+          "between passes {:.2f} ms | tail {:.2f} ms\n",
+          frames, frame_ns / f / 1e6, pass_ns / f / 1e6, double(pass_n) / f, gaps.ns / f / 1e6,
+          tail.ns / f / 1e6);
+      const auto& sites = PassTimingSites();
+      for (size_t i = 0; i < sorted.size() && i < 10; ++i) {
+        const Agg& a = by_site[sorted[i].second];
+        report += fmt::format("  {:<32} {:5.1f}/frame  {:6.2f} ms/frame  {:.2f} ms each\n",
+                              sorted[i].second < sites.size() ? sites[sorted[i].second] : "?",
+                              double(a.n) / f, a.ns / f / 1e6, a.ns / double(a.n) / 1e6);
+      }
+      report += "  -- work between passes, by what it was waiting before:\n";
+      std::vector<std::pair<double, uint32_t>> blocks;
+      for (const auto& [id, a] : by_block) {
+        blocks.push_back({a.ns, id});
+      }
+      std::sort(blocks.rbegin(), blocks.rend());
+      for (size_t i = 0; i < blocks.size() && i < 10; ++i) {
+        const Agg& a = by_block[blocks[i].second];
+        report += fmt::format("  {:<32} {:5.1f}/frame  {:6.2f} ms/frame  {:.3f} ms each\n",
+                              blocks[i].second < sites.size() ? sites[blocks[i].second] : "?",
+                              double(a.n) / f, a.ns / f / 1e6, a.ns / double(a.n) / 1e6);
+      }
+      REXGPU_INFO("{}", report);
+      by_block.clear();
+      by_site.clear();
+      gaps = {};
+      tail = {};
+      frames = 0;
+      frame_ns = 0.0;
+    }
+  }
+}
