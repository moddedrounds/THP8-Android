+void VulkanCommandProcessor::FinalizePassRenderArea() {
+  if (!REXCVAR_GET(gpu_limit_render_area) || render_pass_begin_position_ == SIZE_MAX ||
+      current_framebuffer_ == nullptr) {
+    return;
+  }
+  const float coverage = deferred_command_buffer_.LimitRenderPassArea(
+      render_pass_begin_position_, current_framebuffer_->host_extent);
+  static uint64_t passes = 0, limited = 0;  // command processor thread only
+  static double coverage_sum = 0.0;
+  ++passes;
+  coverage_sum += double(coverage);
+  limited += coverage < 0.99f;
+  if (passes % 1000 == 0) {
+    REXGPU_INFO("render area limit: {} passes, mean coverage {:.2f}, {:.0f}% of passes limited",
+                passes, coverage_sum / double(passes), 100.0 * double(limited) / double(passes));
+  }
+}
