+  constexpr int64_t kAlign = 32;
+  int64_t x0 = std::max<int64_t>(0, pass_x0_) / kAlign * kAlign;
+  int64_t y0 = std::max<int64_t>(0, pass_y0_) / kAlign * kAlign;
+  int64_t x1 = std::min<int64_t>(full_extent.width, (pass_x1_ + kAlign - 1) / kAlign * kAlign);
