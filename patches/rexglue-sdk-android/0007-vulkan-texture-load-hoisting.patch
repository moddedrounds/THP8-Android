+        "skipped: {} no pass, {} pending barriers, {} other",
+        g_hoist_requests, g_hoist_started, g_hoist_empty, g_hoist_nonempty, g_hoist_done,
+        g_hoist_fallback, g_hoist_skip_nopass, g_hoist_skip_pending, g_hoist_skip_other);
+  }
+  if (!submission_open_ || !in_render_pass_ || render_pass_begin_position_ == SIZE_MAX) {
+    ++g_hoist_skip_nopass;
+    return false;
+  }
+  if (scratch_buffer_used_ || !shared_memory_ || !shared_memory_->IsPlainRead()) {
+    ++g_hoist_skip_other;
+    return false;
+  }
+  SplitPendingBarrier();
+  if (!pending_barriers_.empty() || !pending_barriers_buffer_memory_barriers_.empty() ||
+      !pending_barriers_image_memory_barriers_.empty()) {
+    ++g_hoist_skip_pending;
+    return false;
+  }
+  texture_hoist_active_ = true;
+  texture_hoist_conflict_ = false;
