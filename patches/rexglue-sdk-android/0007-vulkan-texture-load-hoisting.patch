+void VulkanCommandProcessor::EndTextureHoist() {
+  if (!texture_hoist_active_) {
+    return;
+  }
+  const size_t tail_start = texture_hoist_tail_start_;
+  if (texture_hoist_conflict_) {
+    // Something in the block needs the pass to be over: end it in front of the block, as the
+    // ordinary path would have done at its first barrier.
+    texture_hoist_active_ = false;  // From here on barriers and pass ends act normally again.
+    texture_hoist_conflict_ = false;
+    ++g_hoist_fallback;
+    if (in_render_pass_ && deferred_command_buffer_.Position() > tail_start) {
+      const size_t end_position = deferred_command_buffer_.Position();
+      EndRenderPass();
+      deferred_command_buffer_.MoveTailTo(end_position, tail_start);
+    } else {
+      EndRenderPass();
+    }
+    return;
+  }
+  // Barriers queued by the loads and the usage transitions are part of the block. Flushed while the
+  // hoist is still active: emitting barriers would otherwise end the pass with the block inside it.
+  SubmitBarriers(false);
+  texture_hoist_active_ = false;  // From here on barriers and pass ends act normally again.
+  const size_t block_size = deferred_command_buffer_.Position() - tail_start;
+  ++(block_size ? g_hoist_nonempty : g_hoist_empty);
+  if (block_size && in_render_pass_ && render_pass_begin_position_ != SIZE_MAX) {
+    deferred_command_buffer_.MoveTailTo(tail_start, render_pass_begin_position_);
+    AdvanceRenderPassBeginPosition(block_size);
+    ++g_hoist_done;
+  }
+}
