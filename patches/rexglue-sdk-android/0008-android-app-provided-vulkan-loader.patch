diff --git a/include/rex/platform/dynlib.h b/include/rex/platform/dynlib.h
index e3fc40d..fc4cca0 100644
--- a/include/rex/platform/dynlib.h
+++ b/include/rex/platform/dynlib.h
@@ -31,6 +31,12 @@ class DynamicLibrary {
   DynamicLibrary& operator=(DynamicLibrary&& other) noexcept;
 
   bool Load(const std::filesystem::path& path, SymbolResolution mode = SymbolResolution::kLazy);
+  // Takes over a handle opened elsewhere (the app's custom-driver loader). Never dlclose'd.
+  void AdoptLeakedHandle(void* handle) {
+    Close();
+    handle_ = handle;
+    leaked_ = true;
+  }
   void Close();
   explicit operator bool() const { return handle_ != nullptr; }
 
@@ -43,6 +49,7 @@ class DynamicLibrary {
 
  private:
   void* handle_ = nullptr;
+  bool leaked_ = false;
 };
 
 namespace lib_names {
diff --git a/src/core/dynlib_posix.cpp b/src/core/dynlib_posix.cpp
