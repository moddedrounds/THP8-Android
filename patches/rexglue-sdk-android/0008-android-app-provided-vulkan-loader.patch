--- a/src/core/dynlib_posix.cpp
+++ b/src/core/dynlib_posix.cpp
@@ -33,7 +33,10 @@ bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution mo
 
 void DynamicLibrary::Close() {
   if (handle_) {
-    dlclose(handle_);
+    if (!leaked_) {
+      dlclose(handle_);
+    }
+    leaked_ = false;
     handle_ = nullptr;
   }
 }
