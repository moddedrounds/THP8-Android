+void VulkanPipelineCache::LoadVkPipelineCache(const std::filesystem::path& cache_root) {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const auto& properties = vulkan_device->properties();
+  char name[96];
+  std::snprintf(name, sizeof(name), "vk_pipeline_cache_%04x_%04x_%08x.bin", properties.vendorID,
+                properties.deviceID, properties.driverVersion);
+  vk_pipeline_cache_path_ = cache_root / name;
+  std::error_code ec;
+  if (!std::filesystem::is_regular_file(vk_pipeline_cache_path_, ec)) {
+    REXGPU_INFO("Vulkan pipeline cache: no saved cache ({}), starting empty", name);
+    return;
+  }
+  std::vector<uint8_t> data;
+  {
+    std::ifstream file(vk_pipeline_cache_path_, std::ios::binary | std::ios::ate);
+    if (!file) {
+      return;
+    }
+    const std::streamsize size = file.tellg();
+    if (size <= 0 || size > (std::streamsize(1) << 30)) {
+      return;
+    }
+    data.resize(size_t(size));
+    file.seekg(0);
+    if (!file.read(reinterpret_cast<char*>(data.data()), size)) {
+      return;
+    }
+  }
+  VkPipelineCacheCreateInfo info = {VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  info.initialDataSize = data.size();
+  info.pInitialData = data.data();
+  VkPipelineCache loaded = VK_NULL_HANDLE;
+  if (dfn.vkCreatePipelineCache(device, &info, nullptr, &loaded) != VK_SUCCESS) {
+    REXGPU_WARN("Vulkan pipeline cache: the driver rejected {}", name);
+    return;
+  }
+  if (dfn.vkMergePipelineCaches(device, vk_pipeline_cache_, 1, &loaded) == VK_SUCCESS) {
+    REXGPU_INFO("Vulkan pipeline cache: loaded {} ({} KB)", name, data.size() >> 10);
+  }
+  dfn.vkDestroyPipelineCache(device, loaded, nullptr);
+}
+
+void VulkanPipelineCache::SaveVkPipelineCache(bool force) {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE || vk_pipeline_cache_path_.empty() ||
+      vk_pipeline_cache_unsaved_.load(std::memory_order_relaxed) == 0) {
+    return;
+  }
+  const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now().time_since_epoch())
+                             .count();
+  if (!force && now_ms - vk_pipeline_cache_last_save_ms_.load(std::memory_order_relaxed) < 20000) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(vk_pipeline_cache_save_lock_, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return;
+  }
+  vk_pipeline_cache_last_save_ms_.store(now_ms, std::memory_order_relaxed);
+  vk_pipeline_cache_unsaved_.store(0, std::memory_order_relaxed);
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_, &size, nullptr) != VK_SUCCESS || !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  VkResult result = dfn.vkGetPipelineCacheData(device, vk_pipeline_cache_, &size, data.data());
+  if (result != VK_SUCCESS && result != VK_INCOMPLETE) {
+    return;
+  }
+  data.resize(size);
+  std::filesystem::path temp = vk_pipeline_cache_path_;
+  temp += ".tmp";
+  {
+    std::ofstream file(temp, std::ios::binary | std::ios::trunc);
+    if (!file) {
+      return;
+    }
+    file.write(reinterpret_cast<const char*>(data.data()), std::streamsize(data.size()));
+    if (!file) {
+      return;
+    }
+  }
+  std::error_code ec;
+  std::filesystem::rename(temp, vk_pipeline_cache_path_, ec);
+  if (!ec) {
+    REXGPU_INFO("Vulkan pipeline cache: saved {} KB", data.size() >> 10);
+  }
+}
