+    merge_pass_serial_ = pass_serial;
+    merge_position_ = begin_position + (trailing_barrier_start - tail_start);
+    command_processor_.AdvanceRenderPassBeginPosition(moved);
+  }
   hoisted_upload_failed_ = !successful;
   return true;
 }
