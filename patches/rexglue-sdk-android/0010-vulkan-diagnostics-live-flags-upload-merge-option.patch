+// Diagnostic live switches: the integer in <files>/live_flags.txt, re-read about once a second
+// (bit 0 = drop every draw). For measuring fixed vs per-draw GPU cost without restarting.
+uint32_t LiveDiagnosticFlags() {
+  static uint32_t countdown = 0;
+  static uint32_t flags = 0;
+  if (countdown-- == 0) {
+    countdown = 600;
+    flags = 0;
+    if (FILE* f = std::fopen("/sdcard/Android/data/org.project8recomp.android/files/live_flags.txt",
+                             "r")) {
+      unsigned v = 0;
+      if (std::fscanf(f, "%u", &v) == 1) {
+        flags = v;
+      }
+      std::fclose(f);
+    }
+  }
+  return flags;
+}
+
+// Live diagnostic bit 2 (value 4): per-frame histogram of draws by render target configuration,
+// logged at every swap (which passes make a heavy frame heavy).
+struct DrawHistogramKey {
+  uint32_t v[5];
+  bool operator<(const DrawHistogramKey& o) const {
+    return std::lexicographical_compare(v, v + 5, o.v, o.v + 5);
+  }
+};
+struct DrawOutputStats {
+  uint32_t total = 0, no_output = 0, no_output_query = 0, tiny = 0, depth_only = 0;
+};
+DrawOutputStats& DrawOutputs() {
+  static DrawOutputStats stats;  // command processor thread only
+  return stats;
+}
+std::map<DrawHistogramKey, uint32_t>& DrawHistogram() {
+  static std::map<DrawHistogramKey, uint32_t> h;  // command processor thread only
+  return h;
+}
+void FlushDrawHistogram(uint64_t frame) {
+  auto& h = DrawHistogram();
+  uint32_t total = 0;
+  std::vector<std::pair<uint32_t, DrawHistogramKey>> sorted;
+  for (const auto& [k, n] : h) {
+    total += n;
+    sorted.push_back({n, k});
+  }
+  h.clear();
+  if (!total) {
+    return;
+  }
+  std::sort(sorted.rbegin(), sorted.rend());
+  const DrawOutputStats out = DrawOutputs();
+  DrawOutputs() = {};
+  std::string line = fmt::format(
+      "draw histogram frame {}: {} draws in {} groups; {} write nothing ({} of them with an "
+      "occlusion query), {} depth-only, {} with <=6 vertices:",
+      frame, total, sorted.size(), out.no_output, out.no_output_query, out.depth_only, out.tiny);
+  for (size_t i = 0; i < sorted.size() && i < 12; ++i) {
+    const auto& k = sorted[i].second.v;
+    line += fmt::format(
+        "\n   {:4} draws  pitch {:4} msaa {} | c0 base {:4} fmt {} | d base {:4} fmt {} | mode {} | "
+        "scissor br {}x{}",
+        sorted[i].first, k[0] & 0x3FFF, (k[0] >> 16) & 3, k[1] & 0xFFF, (k[1] >> 16) & 0xF,
+        k[2] & 0xFFF, (k[2] >> 16) & 1, k[3] & 7, k[4] & 0x7FFF, (k[4] >> 16) & 0x7FFF);
+  }
+  REXGPU_INFO("{}", line);
+}
