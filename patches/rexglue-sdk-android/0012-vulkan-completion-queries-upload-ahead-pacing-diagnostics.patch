+void SharedMemory::ExtendUploadRangesOverInvalid(
+    std::vector<std::pair<uint32_t, uint32_t>>& page_ranges, uint32_t max_extra_pages) {
+  if (page_ranges.empty()) {
+    return;
+  }
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    for (std::pair<uint32_t, uint32_t>& range : page_ranges) {
+      uint32_t first = range.first;
+      uint32_t last = range.first + range.second - 1;
+      const uint32_t first_min = first - std::min(first & 63, max_extra_pages);
+      const uint32_t last_max = last + std::min(63 - (last & 63), max_extra_pages);
+      const uint64_t valid_first = system_page_flags_valid_[first >> 6];
+      while (first > first_min && !((valid_first >> ((first - 1) & 63)) & 1)) {
+        --first;
+      }
+      const uint64_t valid_last = system_page_flags_valid_[last >> 6];
+      while (last < last_max && !((valid_last >> ((last + 1) & 63)) & 1)) {
+        ++last;
+      }
+      range = std::make_pair(first, last - first + 1);
+    }
+  }
+  size_t write = 0;
+  for (size_t i = 1; i < page_ranges.size(); ++i) {
+    std::pair<uint32_t, uint32_t>& previous = page_ranges[write];
+    const std::pair<uint32_t, uint32_t>& current = page_ranges[i];
+    if (current.first <= previous.first + previous.second) {
+      previous.second =
+          std::max(previous.first + previous.second, current.first + current.second) -
+          previous.first;
+    } else {
+      page_ranges[++write] = current;
+    }
+  }
+  page_ranges.resize(write + 1);
+}
