+std::chrono::steady_clock::time_point GraphicsSystem::NextVblankTime() const {
+  if (!vblank_grid_ready_.load(std::memory_order_acquire)) {
+    return {};
+  }
+  return vblank_epoch_ +
+         vblank_interval_ * int64_t(vblanks_delivered_.load(std::memory_order_acquire) + 1);
+}
+
+void GraphicsSystem::DeliverDueVblanks(bool try_only) {
+  if (!vblank_grid_ready_.load(std::memory_order_acquire)) {
+    return;
+  }
+  const uint64_t due =
+      uint64_t((std::chrono::steady_clock::now() - vblank_epoch_) / vblank_interval_);
+  if (vblanks_delivered_.load(std::memory_order_acquire) >= due) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(vblank_delivery_mutex_, std::defer_lock);
+  if (try_only) {
+    if (!lock.try_lock()) {
+      return;  // Someone is delivering right now.
+    }
+  } else {
+    lock.lock();
+  }
+  uint64_t delivered = vblanks_delivered_.load(std::memory_order_acquire);
+  // After a long stall (suspend, debugger) deliver at most 4: never a burst of thousands.
+  if (due > delivered + 4) {
+    delivered = due - 4;
+  }
+  while (delivered < due) {
+    ++delivered;
+    vblanks_delivered_.store(delivered, std::memory_order_release);
+    MarkVblank();
+  }
+}
 
