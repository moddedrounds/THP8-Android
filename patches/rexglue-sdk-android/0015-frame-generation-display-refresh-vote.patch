diff --git a/src/ui/window_sdl.cpp b/src/ui/window_sdl.cpp
index b5174ff..f705251 100644
--- a/src/ui/window_sdl.cpp
+++ b/src/ui/window_sdl.cpp
@@ -42,6 +42,14 @@
 #include <rex/ui/surface_android.h>
 #endif
 
+#if REX_PLATFORM_ANDROID
+#include <dlfcn.h>
+REXCVAR_DEFINE_DOUBLE(android_display_refresh_hz, 0.0, "Android",
+                      "Display refresh rate to request for the game surface (0 = leave it; 120 for "
+                      "frame generation x4 on a 120 Hz panel)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+#endif
+
 namespace rex::ui {
 
 namespace {
@@ -414,6 +422,19 @@ std::unique_ptr<Surface> WindowSDL::CreateSurfaceImpl(Surface::TypeFlags allowed
     auto* native_window = static_cast<ANativeWindow*>(SDL_GetPointerProperty(
         props, SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, nullptr));
     if (native_window) {
+      // Ask for a display refresh rate (e.g. 120 Hz for frame generation x4). API 31, so resolved
+      // at run time.
+      const double refresh_hz = REXCVAR_GET(android_display_refresh_hz);
+      if (refresh_hz > 0.0) {
+        using SetFrameRateFn = int32_t (*)(ANativeWindow*, float, int8_t, int8_t);
+        static auto set_frame_rate = reinterpret_cast<SetFrameRateFn>(
+            dlsym(dlopen("libandroid.so", RTLD_NOW), "ANativeWindow_setFrameRateWithChangeStrategy"));
+        if (set_frame_rate) {
+          // FRAME_RATE_COMPATIBILITY_FIXED_SOURCE = 1, CHANGE_FRAME_RATE_ALWAYS = 1.
+          const int32_t result = set_frame_rate(native_window, float(refresh_hz), 1, 1);
+          REXLOG_INFO("Android: requested a {} Hz display refresh: {}", refresh_hz, result);
+        }
+      }
       return std::make_unique<AndroidNativeWindowSurface>(native_window);
     }
   }
