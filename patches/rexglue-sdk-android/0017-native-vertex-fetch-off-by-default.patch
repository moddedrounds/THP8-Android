+void Shader::ComputeNativeVertexFetchLayout() {
+  NativeVertexFetchLayout& layout = native_vertex_fetch_layout_;
+  layout = NativeVertexFetchLayout();
+  layout.attributes.resize(vertex_fetch_order_.size());
+  // With jumps, calls or loops, code before a write to r0.x may run again after it.
