+  std::vector<uint32_t> layout_binding_of(vertex_bindings_.size(), UINT32_MAX);
+  uint32_t native_count = 0;
+  for (size_t i = 0; i < vertex_fetch_order_.size(); ++i) {
+    const VertexFetchOrderEntry& entry = vertex_fetch_order_[i];
+    if (!entry.index_is_vertex_index || entry.binding_index >= vertex_bindings_.size()) {
+      continue;
+    }
+    const VertexBinding& binding = vertex_bindings_[entry.binding_index];
+    if (entry.attribute_index >= binding.attributes.size()) {
+      continue;
+    }
+    const ParsedVertexFetchInstruction& fetch = binding.attributes[entry.attribute_index].fetch_instr;
+    uint32_t stride = fetch.attributes.stride;
+    if (!stride || stride != binding.stride_words || stride * 4 > kMaxStride) {
+      continue;
+    }
+    uint32_t needed_words = xenos::GetVertexFormatNeededWords(
+        fetch.attributes.data_format, fetch.result.GetUsedResultComponents());
+    if (!needed_words) {
+      continue;
+    }
+    uint32_t first_word = 0, last_word = 0;
+    rex::bit_scan_forward(needed_words, &first_word);
