+      }
+    }
+    uint32_t word_count = last_word - first_word + 1;
+    int32_t offset_words = fetch.attributes.offset + int32_t(first_word);
+    if (word_count > 4 || offset_words < 0 || uint32_t(offset_words) * 4 > kMaxOffset) {
+      continue;
+    }
+    uint32_t& layout_binding = layout_binding_of[entry.binding_index];
+    if (layout_binding == UINT32_MAX) {
+      layout_binding = uint32_t(layout.bindings.size());
+      layout.bindings.push_back({binding.fetch_constant, stride});
+    }
+    NativeVertexFetchLayout::Attribute& attribute = layout.attributes[i];
+    attribute.binding = layout_binding;
+    attribute.first_word = first_word;
+    attribute.word_count = word_count;
+    attribute.offset_bytes = uint32_t(offset_words) * 4;
+    ++native_count;
+  }
+  if (!native_count || layout.bindings.size() > kMaxBindings ||
+      layout.attributes.size() > kMaxAttributes) {
