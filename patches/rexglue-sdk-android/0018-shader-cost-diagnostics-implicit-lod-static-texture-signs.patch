+uint32_t SpirvShaderTranslator::GetStaticTextureSignClass(uint32_t fetch_constant_index) const {
+  if (!is_pixel_shader()) {
+    return 0;
+  }
+  const uint32_t classes = GetSpirvShaderModification().pixel.texture_sign_classes;
+  if (!classes) {
+    return 0;
+  }
+  uint32_t seen = 0, ordinal = 0;
+  for (const Shader::TextureBinding& binding : current_shader().texture_bindings()) {
+    const uint32_t bit = UINT32_C(1) << binding.fetch_constant;
+    if (seen & bit) {
+      continue;
+    }
+    seen |= bit;
+    if (binding.fetch_constant == fetch_constant_index) {
+      return ordinal < 5 ? (classes >> (2 * ordinal)) & 3 : 0;
+    }
+    ++ordinal;
+  }
+  return 0;
+}
+
