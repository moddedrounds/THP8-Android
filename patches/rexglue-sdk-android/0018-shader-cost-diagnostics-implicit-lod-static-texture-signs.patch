                                             nullptr);
+  fast_math_ = is_pixel_shader() && GetSpirvShaderModification().pixel.fast_math;
+  builder_->setContractionAllowed(fast_math_);
+  ieee_mul_ = fast_math_ || (!is_pixel_shader() && GetSpirvShaderModification().vertex.ieee_mul);
+  implicit_lod_ = is_pixel_shader() && GetSpirvShaderModification().pixel.implicit_lod;
+  implicit_lod_bias_ = spv::NoResult;
+  diag_no_texture_sample_ =
+      is_pixel_shader() && GetSpirvShaderModification().pixel.diag_no_texture_sample;
 
   builder_->addCapability(IsSpirvTessEvalShader() ? spv::CapabilityTessellation
                                                   : spv::CapabilityShader);
