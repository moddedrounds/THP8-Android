 void VulkanCommandProcessor::NoteSharedMemoryRead(uint32_t start, uint32_t length) {
   if (!in_render_pass_ || !length || pass_shared_memory_reads_overflow_) {
     return;
   }
-  // Draws request a handful of ranges each; a pass of hundreds of draws is rare, and a pass that
-  // needs more than this simply keeps the old behaviour (uploads end the pass).
-  constexpr size_t kMaxTrackedReads = 4096;
-  if (pass_shared_memory_reads_.size() >= kMaxTrackedReads) {
-    pass_shared_memory_reads_overflow_ = true;
-    return;
+  if (pass_read_page_bits_.empty()) {
+    pass_read_page_bits_.resize((SharedMemory::kBufferSize >> 12) / 64);
+  }
+  const uint32_t page_first = start >> 12;
+  const uint32_t page_last =
+      std::min(uint32_t((uint64_t(start) + length - 1) >> 12),
+               uint32_t(pass_read_page_bits_.size() * 64 - 1));
+  for (uint32_t word = page_first >> 6; word <= (page_last >> 6); ++word) {
+    uint64_t bits = ~uint64_t(0);
+    if (word == (page_first >> 6)) bits &= ~uint64_t(0) << (page_first & 63);
+    if (word == (page_last >> 6)) bits &= ~uint64_t(0) >> (63 - (page_last & 63));
+    if (!pass_read_page_bits_[word]) pass_read_page_words_.push_back(word);
+    pass_read_page_bits_[word] |= bits;
   }
-  pass_shared_memory_reads_.emplace_back(start, length);
 }
 
