+VulkanRenderTargetCache::VulkanRenderTarget*
+VulkanRenderTargetCache::GetFusedResolveSource(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    bool draw_resolution_scaled) {
+  if (GetPath() != Path::kHostRenderTargets || !REXCVAR_GET(direct_host_resolve) ||
+      REXCVAR_GET(gpu_fused_resolve) == ((g_live_diag_flags & 1073741824u) != 0)) {
+    return nullptr;
+  }
+  VulkanRenderTarget* result = nullptr;
+  // Fallback reasons: 0 copy shader, 1 depth, 2 rectangles, 3 format / MSAA, 4 coverage.
+  static uint64_t fallback_reasons[5] = {};
+  uint32_t fallback_reason = 0;
+  const bool full_copy = copy_shader == draw_util::ResolveCopyShaderIndex::kFull32bpp;
+  if ((copy_shader == draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA || full_copy) &&
+      !draw_resolution_scaled && !resolve_info.IsCopyingDepth() &&
+      direct_resolve_pipeline_layout_color_ != VK_NULL_HANDLE) {
+    fallback_reason = 2;
+    uint32_t span_base, span_row_length, span_rows, span_pitch;
+    resolve_info.GetCopyEdramTileSpan(span_base, span_row_length, span_rows, span_pitch);
+    GetResolveCopyRectanglesToDump(span_base, span_row_length, span_rows, span_pitch,
+                                   dump_rectangles_);
+    if (dump_rectangles_.size() == 1) {
+      const ResolveCopyDumpRectangle& rectangle = dump_rectangles_.front();
+      auto* rt = static_cast<VulkanRenderTarget*>(rectangle.render_target);
+      const RenderTargetKey rt_key = rt->key();
+      fallback_reason = (rt_key.is_depth ||
+                         rt_key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+                         rt_key.msaa_samples > xenos::MsaaSamples::k2X)
+                            ? 3
+                            : 4;
+      if (!rt_key.is_depth &&
+          rt_key.GetColorFormat() == xenos::ColorRenderTargetFormat::k_8_8_8_8 &&
+          rt_key.msaa_samples <= xenos::MsaaSamples::k2X && rectangle.row_first == 0 &&
+          rectangle.rows == span_rows && rectangle.row_first_start == 0 &&
+          rectangle.row_last_end == span_row_length) {
+        fused_resolve_kind_ = kFusedResolveFast;
+        if (full_copy) {
+          // The lean shader: 8_8_8_8 destination, and a sample selection it implements.
+          const uint32_t dest_format = uint32_t(resolve_info.copy_dest_info.copy_dest_format);
+          const uint32_t sample_select =
+              uint32_t(resolve_info.copy_dest_coordinate_info.copy_sample_select);
+          const bool lean_select = rt_key.msaa_samples == xenos::MsaaSamples::k1X
+                                       ? sample_select == 0
+                                       : (sample_select <= 1 || sample_select == 4);
+          fused_resolve_kind_ =
+              ((dest_format == 6 || dest_format == 14 || dest_format == 50) && lean_select)
+                  ? kFusedResolve8888
+                  : kFusedResolveFull;
+        }
+      }
+      if (result == nullptr && fallback_reason == 4 &&
+          rectangle.row_first == 0 && rectangle.rows == span_rows &&
+          rectangle.row_first_start == 0 && rectangle.row_last_end == span_row_length &&
+          GetFusedResolvePipeline(fused_resolve_kind_,
+                                  rt_key.msaa_samples != xenos::MsaaSamples::k1X) !=
+              VK_NULL_HANDLE) {
+        command_processor_.PushImageMemoryBarrier(
+            rt->image(), ui::vulkan::util::InitializeSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT),
+            rt->current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+            rt->current_access_mask(), VK_ACCESS_SHADER_READ_BIT, rt->current_layout(),
+            VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        rt->SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT,
+                     VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        result = rt;
+      }
+    }
+  }
+  if (!result && resolve_info.IsCopyingDepth() && fallback_reason == 0) {
+    fallback_reason = 1;
+  }
+  ++(result ? fused_resolve_count_ : fused_resolve_fallback_count_);
+  if (!result) {
+    ++fallback_reasons[fallback_reason];
+  }
+  if (fused_resolve_count_ + fused_resolve_fallback_count_ >= 4000) {
+    REXGPU_INFO(
+        "fused resolve: {} fused, {} through the EDRAM dump (copy shader {}, depth {}, "
+        "rectangles {}, format/MSAA {}, coverage {}; last copy shader {})",
+        fused_resolve_count_, fused_resolve_fallback_count_, fallback_reasons[0],
+        fallback_reasons[1], fallback_reasons[2], fallback_reasons[3], fallback_reasons[4],
+        uint32_t(copy_shader));
+    fused_resolve_count_ = fused_resolve_fallback_count_ = 0;
+    for (uint64_t& reason : fallback_reasons) {
+      reason = 0;
+    }
+  }
+  return result;
+}
+
+VkPipeline VulkanRenderTargetCache::GetFusedResolvePipeline(FusedResolveKind kind, bool msaa) {
+  VkPipeline& pipeline = fused_resolve_pipelines_[kind][msaa ? 1 : 0];
+  if (pipeline == VK_NULL_HANDLE) {
+    static const std::pair<const uint32_t*, size_t> kCode[3][2] = {
+        {{shaders::direct_resolve_fast_32bpp_msaa0_cs,
+          sizeof(shaders::direct_resolve_fast_32bpp_msaa0_cs)},
+         {shaders::direct_resolve_fast_32bpp_msaa1_cs,
+          sizeof(shaders::direct_resolve_fast_32bpp_msaa1_cs)}},
+        {{shaders::direct_resolve_full_32bpp_msaa0_cs,
+          sizeof(shaders::direct_resolve_full_32bpp_msaa0_cs)},
+         {shaders::direct_resolve_full_32bpp_msaa1_cs,
+          sizeof(shaders::direct_resolve_full_32bpp_msaa1_cs)}},
+        {{shaders::direct_resolve_8888_msaa0_cs, sizeof(shaders::direct_resolve_8888_msaa0_cs)},
+         {shaders::direct_resolve_8888_msaa1_cs, sizeof(shaders::direct_resolve_8888_msaa1_cs)}},
+    };
+    const auto& code = kCode[kind][msaa ? 1 : 0];
+    pipeline = ui::vulkan::util::CreateComputePipeline(command_processor_.GetVulkanDevice(),
+                                                       direct_resolve_pipeline_layout_color_,
+                                                       code.first, code.second);
+    if (pipeline == VK_NULL_HANDLE) {
+      REXGPU_ERROR("VulkanRenderTargetCache: failed to create the fused resolve pipeline");
+    }
+  }
+  return pipeline;
+}
