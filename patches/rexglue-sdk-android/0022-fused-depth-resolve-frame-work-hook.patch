diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index cb4e447..c8d2c4c 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -166,6 +166,11 @@ void NoteGuestVblank() {
 }
 
 // Run-queue delay of the calling thread so far (schedstat field 2, ns).
+// Called on the command processor thread at every swap with the command processor's CPU time and
+// run-queue wait for the frame and the frame period target (Android reports them to the platform's
+// performance hints). Set through rex_gpu_set_frame_work_hook (exported for the app).
+void (*g_frame_work_hook)(uint64_t cpu_ns, uint64_t runq_ns, uint64_t target_ns) = nullptr;
+
 uint64_t ThreadRunqNs() {
   uint64_t run = 0, wait = 0;
   if (FILE* f = std::fopen("/proc/thread-self/schedstat", "r")) {
@@ -1485,9 +1490,11 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
     rex::perf::SetCounter(rex::perf::CounterId::kSwapTimeUs,
                           int64_t(now_ts.tv_sec) * 1000000 + now_ts.tv_nsec / 1000);
   }
+  uint64_t frame_runq_ns = 0, frame_cpu_ns = 0;
   {
     static uint64_t last_runq = ThreadRunqNs();
     const uint64_t runq = ThreadRunqNs();
+    frame_runq_ns = runq - last_runq;
     rex::perf::SetCounter(rex::perf::CounterId::kCpRunqUs, int64_t((runq - last_runq) / 1000));
     last_runq = runq;
     rex::perf::SetCounter(rex::perf::CounterId::kVsyncRunqUs,
@@ -1496,9 +1503,14 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   {
     static uint32_t last_cpu_tenths = ThreadCpuTenthsMs();
     const uint32_t cpu_tenths = ThreadCpuTenthsMs();
+    frame_cpu_ns = uint64_t(cpu_tenths - last_cpu_tenths) * 100000;
     rex::perf::SetCounter(rex::perf::CounterId::kCpCpuUs, int64_t(cpu_tenths - last_cpu_tenths) * 100);
     last_cpu_tenths = cpu_tenths;
   }
+  if (g_frame_work_hook) {
+    const uint32_t cap = REXCVAR_GET(gpu_swap_fps_cap);
+    g_frame_work_hook(frame_cpu_ns, frame_runq_ns, 1000000000ull / (cap ? cap : 60));
+  }
   {
     static uint32_t swaps = 0;
     static auto last_swap = std::chrono::steady_clock::now();
@@ -2299,3 +2311,8 @@ bool CommandProcessor::ExecutePacketType3_VIZ_QUERY(memory::RingBuffer* reader,
 }
 
 }  // namespace rex::graphics
+
+extern "C" __attribute__((visibility("default"))) void rex_gpu_set_frame_work_hook(
+    void (*hook)(uint64_t cpu_ns, uint64_t runq_ns, uint64_t target_ns)) {
+  rex::graphics::g_frame_work_hook = hook;
+}
