diff --git a/src/ui/overlay/debug_overlay.cpp b/src/ui/overlay/debug_overlay.cpp
index 43d6c06..cbfa297 100644
--- a/src/ui/overlay/debug_overlay.cpp
+++ b/src/ui/overlay/debug_overlay.cpp
@@ -12,6 +12,9 @@
 #include <rex/ui/overlay/debug_overlay.h>
 #include <rex/version.h>
 #include <imgui.h>
+#include <chrono>
+#include <cstdio>
+
 #ifdef REXGLUE_ENABLE_PERF_COUNTERS
 #include <rex/perf/counter.h>
 #include <cinttypes>
@@ -25,7 +28,44 @@ DebugOverlayDialog::DebugOverlayDialog(ImGuiDrawer* imgui_drawer, FrameStatsProv
 DebugOverlayDialog::~DebugOverlayDialog() {}
 
 void DebugOverlayDialog::OnDraw(ImGuiIO& io) {
-  ImGui::SetNextWindowPos(ImVec2(10, 10), ImGuiCond_FirstUseEver);
+#ifdef REXGLUE_ENABLE_PERF_COUNTERS
+  if (compact_) {
+    // Compact mode (the startup flag): only the guest frame rate, e.g. "60 fps", from the guest
+    // frame times averaged over half a second (with frame generation this is the game's own rate).
+    static double sum_ms = 0.0;
+    static uint32_t samples = 0;
+    static char text[32] = "-- fps";
+    static auto last_update = std::chrono::steady_clock::now();
+    const double ft_ms =
+        double(rex::perf::GetSnapshotCounter(rex::perf::CounterId::kFrameTimeUs)) / 1000.0;
+    if (ft_ms > 0.0) {
+      sum_ms += ft_ms;
+      ++samples;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_update >= std::chrono::milliseconds(500) && samples) {
+      std::snprintf(text, sizeof(text), "%.0f fps", 1000.0 / (sum_ms / samples));
+      sum_ms = 0.0;
+      samples = 0;
+      last_update = now;
+    }
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x - 10, 10), ImGuiCond_Always,
+                            ImVec2(1.0f, 0.0f));
+    ImGui::SetNextWindowBgAlpha(0.45f);
+    if (ImGui::Begin("##fps", nullptr,
+                     ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_AlwaysAutoResize |
+                         ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoSavedSettings |
+                         ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoNav)) {
+      ImGui::SetWindowFontScale(2.0f);
+      ImGui::TextUnformatted(text);
+    }
+    ImGui::End();
+    return;
+  }
+#endif
+  // Top right: clear of the game's menus and of the test scripts' colour probes.
+  ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x - 10, 10), ImGuiCond_FirstUseEver,
+                          ImVec2(1.0f, 0.0f));
 #ifdef REXGLUE_ENABLE_PERF_COUNTERS
   ImGui::SetNextWindowSize(ImVec2(280, 280), ImGuiCond_FirstUseEver);
 #else
