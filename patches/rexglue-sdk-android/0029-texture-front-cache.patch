+  // Direct-mapped front of textures_ for FindOrCreateTexture (the node walk of the map was ~5 % of
+  // the command processor). Cleared whenever a texture is destroyed.
+  struct TextureFrontEntry {
+    TextureKey key;
+    Texture* texture = nullptr;
