 TextureCache::Texture* TextureCache::FindOrCreateTexture(TextureKey key) {
+  const bool front_cacheable = !IsDrawResolutionScaled();
+  TextureFrontEntry* front = nullptr;
+  if (front_cacheable) {
+    front = &texture_front_cache_[TextureFrontIndex(key)];
+    if (front->texture && front->key == key) {
+      return front->texture;
+    }
+  }
+  const TextureKey requested_key = key;
+  Texture* result = FindOrCreateTextureUncached(key);
+  if (front && result) {
+    front->key = requested_key;
+    front->texture = result;
+  }
+  return result;
+}
