+  static constexpr uint32_t kTextureFrontCacheSize = 1024;
+  std::unique_ptr<TextureFrontEntry[]> texture_front_cache_{
+      new TextureFrontEntry[kTextureFrontCacheSize]};
+  void ClearTextureFrontCache() {
+    for (uint32_t i = 0; i < kTextureFrontCacheSize; ++i) texture_front_cache_[i].texture = nullptr;
+  }
+  static uint32_t TextureFrontIndex(const TextureKey& key) {
+    uint64_t words[2] = {};
+    std::memcpy(words, &key, std::min(sizeof(words), sizeof(key)));
+    uint64_t hash = (words[0] ^ (words[1] * 0x9E3779B97F4A7C15ull)) * 0xC2B2AE3D27D4EB4Full;
+    return uint32_t(hash >> 54) & (kTextureFrontCacheSize - 1);
+  }
 
   uint64_t textures_total_host_memory_usage_ = 0;
 
