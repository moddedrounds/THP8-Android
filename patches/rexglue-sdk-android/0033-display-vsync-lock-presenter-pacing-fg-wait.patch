+namespace {
+std::atomic<int64_t> g_display_vsync_ns{0}, g_display_period_ns{0};
+inline int64_t SteadyNowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+}  // namespace
+
+bool GetPresentPhases(float& paint_phase, float& refresh_phase);
+
+void SetDisplayVsync(int64_t vsync_ns, int64_t period_ns) {
+  g_display_period_ns.store(period_ns, std::memory_order_relaxed);
+  g_display_vsync_ns.store(vsync_ns, std::memory_order_release);
+}
+
+bool GetDisplayVsync(int64_t& vsync_ns, int64_t& period_ns) {
+  vsync_ns = g_display_vsync_ns.load(std::memory_order_acquire);
+  period_ns = g_display_period_ns.load(std::memory_order_relaxed);
+  return vsync_ns && period_ns > 1000000 && SteadyNowNs() - vsync_ns < 250000000;
+}
+
+float DisplayVsyncPhase(int64_t now_ns) {
+  int64_t vsync, period;
+  if (!GetDisplayVsync(vsync, period)) {
+    return -1.0f;
+  }
+  int64_t d = (now_ns - vsync) % period;
+  if (d < 0) d += period;
+  return float(double(d) / double(period));
+}
+
+namespace {
+// Presentation pacing counters (logged about every 10 s of painting): how many paints showed a new
+// guest frame, how many repeated the previous one, and how many guest frames were replaced in the
+// mailbox before any paint picked them up (never shown). With the UI thread painting at the display
+// rate (any UI drawer, e.g. the fps overlay) and the guest frames on their own clock, repeats and
+// never-shown frames are judder that the guest frame rate does not show.
+std::atomic<bool> g_pacing_ready_pending{false};
+std::atomic<uint64_t> g_pacing_refreshes{0}, g_pacing_dropped{0}, g_pacing_paints{0},
+    g_pacing_new{0};
+// Display-refresh phase histograms (10 bins) of paints (guest output consumed) and guest refreshes.
+std::atomic<uint32_t> g_phase_paint[10], g_phase_refresh[10];
+// Circular EMA of a phase as a unit vector (written by one thread each; read racily by the vsync
+// thread, which only steers by it).
+struct PhaseMean {
+  std::atomic<float> x{0.0f}, y{0.0f};
+  void Add(float phase) {
+    const float a = 0.05f;
+    const float angle = phase * 6.2831853f;
+    x.store(x.load(std::memory_order_relaxed) * (1.0f - a) + std::cos(angle) * a,
+            std::memory_order_relaxed);
+    y.store(y.load(std::memory_order_relaxed) * (1.0f - a) + std::sin(angle) * a,
+            std::memory_order_relaxed);
+  }
+  bool Get(float& phase) const {
+    const float fx = x.load(std::memory_order_relaxed), fy = y.load(std::memory_order_relaxed);
+    if (fx * fx + fy * fy < 1e-4f) return false;
+    phase = std::atan2(fy, fx) / 6.2831853f;
+    if (phase < 0.0f) phase += 1.0f;
+    return true;
+  }
+};
+PhaseMean g_mean_paint, g_mean_refresh;
+std::mutex g_consumed_mutex;
+std::condition_variable g_consumed_cv;
+inline void NotePhase(std::atomic<uint32_t>* bins) {
+  const float ph = DisplayVsyncPhase(SteadyNowNs());
+  if (ph >= 0.0f) {
+    bins[std::min(9, int(ph * 10.0f))].fetch_add(1, std::memory_order_relaxed);
+    (bins == g_phase_paint ? g_mean_paint : g_mean_refresh).Add(ph);
+  }
+}
+inline std::string TakePhases(std::atomic<uint32_t>* bins) {
+  std::string out;
+  for (int i = 0; i < 10; ++i) {
+    out += std::to_string(bins[i].exchange(0, std::memory_order_relaxed));
+    out += i < 9 ? "/" : "";
+  }
+  return out;
+}
