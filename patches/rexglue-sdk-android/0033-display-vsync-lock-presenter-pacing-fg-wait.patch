+void GraphicsSystem::LockVblankGridToDisplay() {
+  int64_t vsync_ns, period_ns;
+  if (!ui::GetDisplayVsync(vsync_ns, period_ns)) {
+    return;
+  }
+  // Guest vblanks per display refresh: 60 Hz guest on a 60 Hz display = every refresh, on 120 Hz
+  // every second one (the target phase is then within a 2-refresh cycle).
+  const int64_t interval_ns =
+      std::chrono::duration_cast<std::chrono::nanoseconds>(vblank_interval_).count();
+  const int64_t k = std::max<int64_t>(1, (interval_ns + period_ns / 2) / period_ns);
+  const int64_t cycle_ns = k * period_ns;
+  const int64_t edge_ns = NextVblankTime().time_since_epoch().count();
+  // Automatic phase: the presenter takes the newest guest frame at a fairly fixed point of each
+  // refresh (paint phase); guest frames must reach it half a refresh away from that point. The
+  // vblank's phase is integrated towards where the measured refresh phase lands there (the swap
+  // follows the vblank by a few ms, so the vblank phase itself is not the target).
+  static double auto_phase = 0.2;
+  double phase = 0.0;
+  const int32_t fixed = REXCVAR_GET(gpu_vblank_display_phase_pct);
+  if (fixed >= 0) {
+    phase = std::min(fixed, 99) / 100.0;
+  } else {
+    float paint, refresh;
+    if (ui::GetPresentPhases(paint, refresh)) {
+      double err = double(paint) + 0.5 - double(refresh);
+      err -= std::floor(err + 0.5);  // -0.5..0.5
+      auto_phase += 0.02 * err;
+      auto_phase -= std::floor(auto_phase);
+    }
+    phase = auto_phase;
+  }
+  const int64_t target_offset = vsync_ns + int64_t(double(period_ns) * phase);
+  int64_t err = (target_offset - edge_ns) % cycle_ns;  // how much later the edge should be
+  if (err > cycle_ns / 2) err -= cycle_ns;
+  if (err < -cycle_ns / 2) err += cycle_ns;
+  const int64_t slew_ns = int64_t(std::max(0, REXCVAR_GET(gpu_vblank_display_slew_us))) * 1000;
+  const int64_t correction = std::clamp(err, -slew_ns, slew_ns);
+  if (correction) {
+    std::lock_guard<std::mutex> lock(vblank_delivery_mutex_);
+    vblank_epoch_.fetch_add(correction, std::memory_order_acq_rel);
+  }
+}
