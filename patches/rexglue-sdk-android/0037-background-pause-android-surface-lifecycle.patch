+void WindowSDL::HandleAndroidLifecycle(bool foreground) {
+#if REX_PLATFORM_ANDROID
+  if (!foreground) {
+    REXLOG_INFO("Android: app in the background, presenter surface released");
+    OnSurfaceChanged(false);
+    android_native_window_ = nullptr;
+    return;
+  }
+  CheckAndroidSurface();
+#else
+  (void)foreground;
+#endif
+}
+
+void WindowSDL::CheckAndroidSurface() {
+#if REX_PLATFORM_ANDROID
+  void* current = SDL_GetPointerProperty(SDL_GetWindowProperties(sdl_window_),
+                                         SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, nullptr);
+  if (current && current != android_native_window_) {
+    REXLOG_INFO("Android: new native window, re-creating the presenter surface");
+    OnSurfaceChanged(true);
+    OnPaint(true);
+  }
+#endif
+}
