#version 450
// Lean fused resolve of an 8_8_8_8 render target to an 8_8_8_8 destination (copy_dest_format 6,
// 14 or 50), with or without averaging guest samples 0 and 1: what the SDK resolve_full_32bpp copy
// shader computes for that case, bit for bit (the 8-bit values are recovered from the host render
// target and converted with the same constants), but read straight from the render target - one
// tile lookup per invocation, no EDRAM dump, no EDRAM buffer.
// Build: tools/android/resolve_shaders/build.sh (MSAA=0 and MSAA=1 variants).
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) writeonly buffer XeResolveDest { uvec4 dest[]; };
#if MSAA
layout(set = 1, binding = 0) uniform texture2DMS xe_source;
#else
layout(set = 1, binding = 0) uniform texture2D xe_source;
#endif

layout(push_constant, std430) uniform XeDirectResolveConstants {
  uint edram_info;            // draw_util::ResolveEdramInfo
  uint coordinate_info;       // draw_util::ResolveCoordinateInfo
  uint dest_info;             // reg::RB_COPY_DEST_INFO
  uint dest_coordinate_info;  // draw_util::ResolveCopyDestCoordinateInfo
  uint dest_base;
  uint source_base_tiles;     // EDRAM tile of the render target origin
  uint source_pitch_tiles;
  uint source_sample_ids;     // host sample index of guest sample 0 (bits 0:1) and 1 (bits 2:3)
} c;

// 8_8_8_8 sample as the copy shader sees it after the EDRAM round trip: the 8-bit value times the
// float constant the copy shader uses for 1/255.
vec4 Unpack8888(vec4 host) {
  return vec4(uvec4(host * 255.0 + 0.5)) * 0.0039215688593685626983642578125;
}

uint Pack8888(vec4 value) {
  uvec4 u = uvec4(clamp(value, vec4(0.0), vec4(1.0)) * 255.0 + vec4(0.5));
  return u.x | (u.y << 8u) | (u.z << 16u) | (u.w << 24u);
}

void main() {
  uvec2 pixel_index = gl_GlobalInvocationID.xy << uvec2(2u, 0u);
  if (pixel_index.x >= (((c.coordinate_info >> 5u) & 2047u) << 3u)) {
    return;
  }
  uint dest_endian = c.dest_info & 7u;
  uint dest_pitch_aligned = (c.dest_coordinate_info & 1023u) << 5u;
  uint sample_select = (c.dest_coordinate_info >> 28u) & 7u;
#if MSAA
  // 2x: one row of samples per guest sample. Averaging (select 4, samples 0 and 1) starts at
  // sample 0; a single selected sample starts at its own row.
  bool average = sample_select == 4u;
  uint first_sample = average ? 0u : (sample_select & 1u);
#endif

  // EDRAM sample coordinates of the first pixel (as the copy shader computes them for 32bpp).
  uvec2 edram_sample =
      pixel_index + (((uvec2(c.coordinate_info) >> uvec2(0u, 4u)) & uvec2(15u, 1u)) << uvec2(3u));
#if MSAA
  edram_sample.y = (edram_sample.y << 1u) + first_sample;
#endif
  uvec2 edram_tile = edram_sample / uvec2(80u, 16u);
  uvec2 tile_sample = edram_sample - edram_tile * uvec2(80u, 16u);
  uint tile = (((c.edram_info >> 13u) & 2047u) + edram_tile.y * (c.edram_info & 1023u) +
               edram_tile.x) &
              2047u;
  // The render target pixel holding it (the inverse of the EDRAM dump addressing).
  uint source_tile = (tile + 2048u - c.source_base_tiles) & 2047u;
  uint source_tile_y = source_tile / c.source_pitch_tiles;
  uint source_tile_x = source_tile - source_tile_y * c.source_pitch_tiles;
  uint sample_x = source_tile_x * 80u + tile_sample.x;
  uint sample_y = source_tile_y * 16u + tile_sample.y;

  float exp_factor = intBitsToFloat((((int(c.dest_info) << 10) >> 26) << 23) + 1065353216);
  vec4 value[4];
#if MSAA
  ivec2 pixel = ivec2(uvec2(sample_x, sample_y >> 1u));
  int host_sample_first = int((c.source_sample_ids >> ((sample_y & 1u) << 1u)) & 3u);
  int host_sample_1 = int((c.source_sample_ids >> 2u) & 3u);
  ivec2 size = textureSize(xe_source);
  for (int i = 0; i < 4; ++i) {
    ivec2 p = min(pixel + ivec2(i, 0), size - 1);
    vec4 v = Unpack8888(texelFetch(xe_source, p, host_sample_first));
    if (average) {
      v = (v + Unpack8888(texelFetch(xe_source, p, host_sample_1))) * (exp_factor * 0.5);
    } else {
      v *= exp_factor;
    }
    value[i] = v;
  }
#else
  ivec2 pixel = ivec2(uvec2(sample_x, sample_y));
  ivec2 size = textureSize(xe_source, 0);
  for (int i = 0; i < 4; ++i) {
    value[i] = Unpack8888(texelFetch(xe_source, min(pixel + ivec2(i, 0), size - 1), 0)) *
               exp_factor;
  }
#endif
  if ((c.dest_info & 16777216u) != 0u) {
    for (int i = 0; i < 4; ++i) {
      value[i] = value[i].zyxw;
    }
  }
  uvec4 packed = uvec4(Pack8888(value[0]), Pack8888(value[1]), Pack8888(value[2]),
                       Pack8888(value[3]));

  uvec2 dest_pixel =
      pixel_index + (((uvec2(c.dest_coordinate_info) >> uvec2(20u, 24u)) & uvec2(15u)) << uvec2(3u));
  uint dest_address;
  if ((c.dest_info & 8u) != 0u) {
    // 3D tiled destination.
    int x = int(dest_pixel.x);
    int y = int(dest_pixel.y);
    int z = int((c.dest_info >> 4u) & 7u);
    int z_div_4 = z >> 2;
    int macro = (((x & 7) + ((y & 6) << 2)) << 8) >> 6;
    int bank = ((y >> 3) + z_div_4) & 1;
    int pipe = bank + ((((x >> 3) + (bank << 1)) & 3) << 1);
    int dest_height_aligned = int((((c.dest_coordinate_info >> 10u) & 1023u) << 5u) >> 4u);
    int offset = ((((((((x >> 5) + ((y >> 4) + z_div_4 * dest_height_aligned) *
                                       int(dest_pitch_aligned >> 5u))
                      << 8) &
                     268435455)
                    << 1) +
                   (macro & -16))
                  << 1) +
                 (macro & 15)) +
                 ((z & 3) << 8) + ((y & 1) << 4);
    dest_address =
        uint(((((((pipe & 1) << 3) + ((offset >> 6) & 7)) << 3) + (pipe & -2)) << 2) +
             (offset & -512)) *
             8u +
         uint(offset & 63);
  } else {
    // 2D tiled destination.
    int x = int(dest_pixel.x);
    int y = int(dest_pixel.y);
    int macro = ((x & 7) + ((y & 14) << 2)) << 2;
    int offset = (((x >> 5) + (y >> 5) * int(dest_pitch_aligned >> 5u)) << 9) +
                 ((macro & -16) << 1) + (macro & 15) + ((y & 1) << 4);
    dest_address = uint(((offset & -512) << 3) + ((y & 16) << 7) + ((offset & 448) << 2) +
                        (((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 63));
  }
  if (dest_endian == 1u || dest_endian == 2u) {
    packed = ((packed & uvec4(16711935u)) << uvec4(8u)) |
             ((packed & uvec4(4278255360u)) >> uvec4(8u));
  }
  if (dest_endian == 2u || dest_endian == 3u) {
    packed = (packed << uvec4(16u)) | (packed >> uvec4(16u));
  }
  dest[(dest_address + c.dest_base) >> 4u] = packed;
}
