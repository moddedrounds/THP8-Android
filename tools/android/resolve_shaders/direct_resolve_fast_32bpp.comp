#version 450
// Fused ("direct") resolve for the fast 32bpp copy path (single sample selected, bit-equivalent
// formats, no exponent bias): the logic of the SDK resolve_fast_32bpp_1x2xmsaa copy shader, but
// the 32-bit EDRAM samples are read straight from the host render target (8_8_8_8, packed as the
// EDRAM dump packs them) instead of from an EDRAM buffer that a dump pass wrote first.
// DEPTH=1: a D24S8 depth render target (depth and stencil views), packed like the dump packs it.
// Build: tools/android/resolve_shaders/build.sh (glslc -O, MSAA=0/1, DEPTH=0/1 variants).
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) writeonly buffer XeResolveDest { uvec4 dest[]; };
#if DEPTH
#if MSAA
layout(set = 1, binding = 0) uniform texture2DMS xe_source;
layout(set = 1, binding = 1) uniform utexture2DMS xe_source_stencil;
#else
layout(set = 1, binding = 0) uniform texture2D xe_source;
layout(set = 1, binding = 1) uniform utexture2D xe_source_stencil;
#endif
#else
#if MSAA
layout(set = 1, binding = 0) uniform texture2DMS xe_source;
#else
layout(set = 1, binding = 0) uniform texture2D xe_source;
#endif
#endif

layout(push_constant, std430) uniform XeDirectResolveConstants {
  uint edram_info;            // draw_util::ResolveEdramInfo
  uint coordinate_info;       // draw_util::ResolveCoordinateInfo
  uint dest_info;             // reg::RB_COPY_DEST_INFO
  uint dest_coordinate_info;  // draw_util::ResolveCopyDestCoordinateInfo
  uint dest_base;
  uint source_base_tiles;     // EDRAM tile of the render target origin
  uint source_pitch_tiles;
  uint source_sample_ids;     // host sample index of guest sample 0 (bits 0:1) and 1 (bits 2:3)
} c;

// The 32-bit EDRAM sample at a sample address: the render target sample that the EDRAM dump
// would have stored there (32bpp tiles are 80x16 samples; 2x MSAA samples are stacked rows).
// The samples one invocation reads mostly lie in one tile: its origin in the render target is
// computed once (the division by the render target pitch is the expensive part).
uint memo_tile = 0xFFFFFFFFu;
uvec2 memo_tile_origin = uvec2(0u);
uint LoadEdramSample(uint address) {
  uint tile = address / 1280u;
  if (tile != memo_tile) {
    memo_tile = tile;
    uint source_tile = (tile + 2048u - c.source_base_tiles) & 2047u;
    uint source_tile_y = source_tile / c.source_pitch_tiles;
    memo_tile_origin =
        uvec2((source_tile - source_tile_y * c.source_pitch_tiles) * 80u, source_tile_y * 16u);
  }
  uint tile_sample = address - tile * 1280u;
  uint tile_sample_y = tile_sample / 80u;
  uint tile_sample_x = tile_sample - tile_sample_y * 80u;
#if DEPTH
  // The dump swaps the 40-sample halves of depth tiles.
  tile_sample_x = tile_sample_x >= 40u ? tile_sample_x - 40u : tile_sample_x + 40u;
#endif
  uint sample_x = memo_tile_origin.x + tile_sample_x;
  uint sample_y = memo_tile_origin.y + tile_sample_y;
#if MSAA
  ivec2 pixel = ivec2(uvec2(sample_x, sample_y >> 1u));
  if (any(greaterThanEqual(pixel, textureSize(xe_source)))) {
    return 0u;
  }
  int sample_id = int((c.source_sample_ids >> ((sample_y & 1u) << 1u)) & 3u);
#if DEPTH
  float depth = texelFetch(xe_source, pixel, sample_id).x;
  uint stencil = texelFetch(xe_source_stencil, pixel, sample_id).x;
#else
  vec4 color = texelFetch(xe_source, pixel, sample_id);
#endif
#else
  ivec2 pixel = ivec2(uvec2(sample_x, sample_y));
  if (any(greaterThanEqual(pixel, textureSize(xe_source, 0)))) {
    return 0u;
  }
#if DEPTH
  float depth = texelFetch(xe_source, pixel, 0).x;
  uint stencil = texelFetch(xe_source_stencil, pixel, 0).x;
#else
  vec4 color = texelFetch(xe_source, pixel, 0);
#endif
#endif
#if DEPTH
  // D24S8: 24-bit depth rounded to the nearest even, stencil in the low 8 bits.
  return (uint(roundEven(depth * 16777215.0)) << 8u) | (stencil & 255u);
#else
  uvec4 unorm = uvec4(color * 255.0 + 0.5);
  return (unorm.x & 255u) | ((unorm.y & 255u) << 8u) | ((unorm.z & 255u) << 16u) |
         (unorm.w << 24u);
#endif
}

uvec4 LoadEdram4(uint index) {
  uint address = index << 2u;
  return uvec4(LoadEdramSample(address), LoadEdramSample(address + 1u),
               LoadEdramSample(address + 2u), LoadEdramSample(address + 3u));
}

uvec4 SwapRedBlue(uvec4 v, uint format) {
  switch (format) {
    case 0u:
    case 1u:
      return ((v & uvec4(4278255360u)) | ((v & uvec4(255u)) << uvec4(16u))) |
             ((v >> uvec4(16u)) & uvec4(255u));
    case 2u:
    case 3u:
    case 10u:
    case 12u:
      return ((v & uvec4(3222273024u)) | ((v & uvec4(1023u)) << uvec4(20u))) |
             ((v >> uvec4(20u)) & uvec4(1023u));
    default:
      return v;
  }
}

uvec4 EndianSwap(uvec4 v, uint endian) {
  if (endian == 1u || endian == 2u) {
    v = ((v & uvec4(16711935u)) << uvec4(8u)) | ((v & uvec4(4278255360u)) >> uvec4(8u));
  }
  if (endian == 2u || endian == 3u) {
    v = (v << uvec4(16u)) | (v >> uvec4(16u));
  }
  return v;
}

void main() {
  uint dest_endian = c.dest_info & 7u;
  uint dest_pitch_aligned = (c.dest_coordinate_info & 1023u) << 5u;
  uint sample_select = (c.dest_coordinate_info >> 28u) & 7u;
  if (gl_GlobalInvocationID.x >= ((c.coordinate_info >> 5u) & 2047u)) {
    return;
  }
  uvec2 pixel_index = gl_GlobalInvocationID.xy << uvec2(3u, 0u);
  uint sample_index;
  if (sample_select <= 3u) {
    sample_index = sample_select;
  } else {
    sample_index = (sample_select == 5u) ? 2u : 0u;
  }
  uvec2 edram_sample =
      ((pixel_index + (((uvec2(c.coordinate_info) >> uvec2(0u, 4u)) & uvec2(15u, 1u)) << uvec2(3u)))
       << uvec2(greaterThanEqual(uvec2((c.edram_info >> 10u) & 3u), uvec2(2u, 1u)))) +
      ((uvec2(sample_index) >> uvec2(1u, 0u)) & uvec2(1u));
  uvec2 edram_tile = edram_sample / uvec2(80u, 16u);
  uvec2 tile_sample = edram_sample - edram_tile * uvec2(80u, 16u);
  if ((c.edram_info & 4096u) != 0u) {
    // Depth: 40-sample column swap.
    tile_sample.x = uint(int(tile_sample.x) + ((tile_sample.x >= 40u) ? -40 : 40));
  }
  uint edram_index = (((((c.edram_info >> 13u) & 2047u) +
                        edram_tile.y * (c.edram_info & 1023u) + edram_tile.x) *
                           1280u +
                       tile_sample.y * 80u + tile_sample.x) %
                      2621440u) >>
                     2u;
  uvec4 samples_0 = LoadEdram4(edram_index);
  uvec4 samples_1 = LoadEdram4(edram_index + 1u);
  if ((c.dest_info & 16777216u) != 0u) {
    uint format = (c.edram_info >> 24u) & 15u;
    samples_0 = SwapRedBlue(samples_0, format);
    samples_1 = SwapRedBlue(samples_1, format);
  }
  uvec2 dest_pixel =
      pixel_index + (((uvec2(c.dest_coordinate_info) >> uvec2(20u, 24u)) & uvec2(15u)) << uvec2(3u));
  uint dest_address;
  if ((c.dest_info & 8u) != 0u) {
    // 3D tiled destination.
    int x = int(dest_pixel.x);
    int y = int(dest_pixel.y);
    int z = int((c.dest_info >> 4u) & 7u);
    int z_div_4 = z >> 2;
    int macro = (((x & 7) + ((y & 6) << 2)) << 8) >> 6;
    int bank = ((y >> 3) + z_div_4) & 1;
    int pipe = bank + ((((x >> 3) + (bank << 1)) & 3) << 1);
    int dest_height_aligned = int((((c.dest_coordinate_info >> 10u) & 1023u) << 5u) >> 4u);
    int offset = ((((((((x >> 5) + ((y >> 4) + z_div_4 * dest_height_aligned) *
                                       int(dest_pitch_aligned >> 5u))
                      << 8) &
                     268435455)
                    << 1) +
                   (macro & -16))
                  << 1) +
                 (macro & 15)) +
                 ((z & 3) << 8) + ((y & 1) << 4);
    dest_address =
        uint(((((((pipe & 1) << 3) + ((offset >> 6) & 7)) << 3) + (pipe & -2)) << 2) +
             (offset & -512)) *
             8u +
         uint(offset & 63);
  } else {
    // 2D tiled destination.
    int x = int(dest_pixel.x);
    int y = int(dest_pixel.y);
    int macro = ((x & 7) + ((y & 14) << 2)) << 2;
    int offset = (((x >> 5) + (y >> 5) * int(dest_pitch_aligned >> 5u)) << 9) +
                 ((macro & -16) << 1) + (macro & 15) + ((y & 1) << 4);
    dest_address = uint(((offset & -512) << 3) + ((y & 16) << 7) + ((offset & 448) << 2) +
                        (((((y & 8) >> 2) + (x >> 3)) & 3) << 6) + (offset & 63));
  }
  uint dest_index = (dest_address + c.dest_base) >> 4u;
  dest[dest_index] = EndianSwap(samples_0, dest_endian);
  dest[dest_index + 2u] = EndianSwap(samples_1, dest_endian);
}
